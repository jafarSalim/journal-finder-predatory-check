{
  "manifest_version": 3,
  "name": "Journal Finder & Predatory Check",
  "version": "1.0.0",
  "description": "Paste your abstract and see which journals publish papers like it, with OpenAlex profiles. Open a journal's site and check it for predatory warning signs.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://api.openalex.org/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Journal Finder & Predatory Check", "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
